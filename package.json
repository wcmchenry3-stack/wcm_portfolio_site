{
  "name": "wcm-portfolio-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n-strings.js",
    "i18n:translate": "node scripts/translate.js",
    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "150 kB"
    },
    {
      "path": "dist/assets/*.css",
      "limit": "20 kB"
    }
  ],
  "dependencies": {
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.6.0",
    "i18next-cli": "^1.64.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "prettier": "^3.9.4",
    "sharp": "^0.35.2",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "tmp": ">=0.2.6",
    "js-yaml": ">=4.2.0",
    "uuid": ">=11.1.1"
  }
}
