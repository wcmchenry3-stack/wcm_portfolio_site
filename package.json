{
  "name": "wcm-portfolio-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n-strings.js",
    "i18n:translate": "node scripts/translate.js",
    "size": "size-limit",
    "lhci": "npx @lhci/cli@0.14.0 autorun"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "150 kB"
    },
    {
      "path": "dist/assets/*.css",
      "limit": "20 kB"
    }
  ],
  "dependencies": {
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@size-limit/file": "^13.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "i18next-cli": "^1.74.1",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "tmp": ">=0.2.6",
    "js-yaml": ">=4.3.1 <5.0.0",
    "uuid": ">=11.1.1"
  }
}
