{
  "name": "wcm-portfolio-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/check-i18n-strings.js",
    "i18n:translate": "node scripts/translate.js",
    "size": "size-limit",
    "lhci": "npx @lhci/cli@0.14.0 autorun"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "150 kB"
    },
    {
      "path": "dist/assets/*.css",
      "limit": "20 kB"
    }
  ],
  "dependencies": {
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "i18next-cli": "^1.85.1",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "size-limit": "^14.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "tmp": ">=0.2.6",
    "js-yaml": ">=4.3.1 <5.0.0",
    "uuid": ">=11.1.1"
  }
}
